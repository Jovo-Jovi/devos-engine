{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(/dev/reviews/**)",
      "Edit(/dev/fences/**)",
      "Edit(/dev/LEDGER.md)",
      "Write(/dev/reviews/**)",
      "Write(/dev/fences/**)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git -C ../devos-sources/tower log *)",
      "Bash(git -C ../devos-sources/tower rev-parse *)",
      "Bash(git -C ../devos-sources/pilot rev-parse *)",
      "Bash(node --version)",
      "Bash(node --check *)",
      "Bash(node --test *)",
      "Bash(node tools/*)",
      "Bash(node bin/devos.mjs *)",
      "Bash(node -e *)"
    ],
    "deny": [
      "Edit(/payload/**)",
      "Edit(/bin/**)",
      "Edit(/lib/**)",
      "Edit(/tools/**)",
      "Edit(/test/**)",
      "Edit(/package.json)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/**)",
      "Edit(/.cursor/**)",
      "Edit(/dev/PLAN.md)",
      "Edit(/dev/DECISIONS.md)",
      "Read(/.env*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Bash(gh *)",
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(npm install *)",
      "Bash(pnpm install *)"
    ]
  }
}
