{
  "$comment": "E86 (PR-106): everything the cycle needs to know about Claude Code. scripts/devos/tools.mjs reads it; the version comes from tool_versions (PR-93). In `run`, {model}, {effort}, {turns}, {schema} (the schema file's text), {last} and {prompt} (the prompt file) are filled in.",
  "id": "claude",
  "name": "Claude",
  "label": "Claude Code",
  "provider": "anthropic",
  "command": "claude",
  "commands": ["claude"],
  "install": { "kind": "npm", "package": "@anthropic-ai/claude-code" },
  "effort": "flag",
  "efforts": ["low", "medium", "high", "xhigh", "max"],
  "fast": false,
  "parser": "claude",
  "answer": "schema",
  "stdin": true,
  "keys": {
    "secret": "CLAUDE_CODE_OAUTH_TOKEN",
    "env": "CLAUDE_OAUTH",
    "cli": "CLAUDE_CODE_OAUTH_TOKEN",
    "alt": { "secret": "ANTHROPIC_API_KEY", "env": "CLAUDE_APIKEY", "cli": "ANTHROPIC_API_KEY" },
    "unset": ["CLAUDE_CODE_OAUTH_TOKEN", "ANTHROPIC_API_KEY"],
    "account": "DEVOS_CLAUDE_ACCOUNT"
  },
  "setup": { "env": {}, "home": [] },
  "kits": {
    "builder": {
      "move": [".claude/settings.json", "CLAUDE.md"],
      "install": [
        { "from": "devos/roles/claude-builder/settings.json", "to": ".claude/settings.json" },
        { "from": "devos/roles/claude-builder/CLAUDE.md", "to": "CLAUDE.md" }
      ]
    }
  },
  "run": {
    "builder": ["-p", "--model", "{model}", "--effort", "{effort}", "--output-format", "stream-json", "--verbose", "--permission-mode", "dontAsk", "--allowedTools", "Read,Glob,Grep,Write,Edit,MultiEdit,Bash,Task,Agent,Skill,mcp__context7", "--disallowedTools", "Bash(git push *),Bash(git commit *),Bash(git checkout *),Bash(git reset *),Bash(gh *),Bash(curl *),Bash(wget *),Bash(pkill *),Bash(killall *)", "--mcp-config", "devos/ci/mcp.claude.json", "--max-turns", "400"],
    "reviewer": ["-p", "--model", "{model}", "--effort", "{effort}", "--output-format", "json", "--json-schema", "{schema}", "--permission-mode", "dontAsk", "--max-turns", "{turns}", "--mcp-config", "devos/ci/mcp.claude.json", "--allowedTools", "Read,Glob,Grep,Write,Edit,Bash,Task,Agent,Skill,mcp__context7,WebFetch(domain:nextjs.org),WebFetch(domain:cursor.com),WebFetch(domain:code.claude.com)", "--disallowedTools", "Bash(git push *),Bash(git commit *),Bash(git checkout *),Bash(git reset *),Bash(gh *),Bash(curl *),Bash(wget *),Bash(pkill *),Bash(killall *)"],
    "planner": ["-p", "--model", "{model}", "--effort", "{effort}", "--output-format", "json", "--json-schema", "{schema}", "--permission-mode", "dontAsk", "--max-turns", "{turns}", "--allowedTools", "Read,Glob,Grep,Write,Edit,Bash,Task,Agent,Skill", "--disallowedTools", "Bash(git push *),Bash(git commit *),Bash(git checkout *),Bash(git reset *),Bash(gh *),Bash(curl *),Bash(wget *),Bash(pkill *),Bash(killall *)"]
  },
  "login": "auth-status"
}
