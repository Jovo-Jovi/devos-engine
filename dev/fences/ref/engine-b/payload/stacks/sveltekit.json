{
  "id": "sveltekit",
  "label": "SvelteKit",
  "languages": [
    "typescript",
    "javascript"
  ],
  "fits": [
    "saas",
    "web-app",
    "dashboard",
    "full"
  ],
  "packageManager": "npm",
  "commands": {
    "install": "npm install",
    "typecheck": "npx svelte-check --tsconfig ./tsconfig.json",
    "lint": "npx eslint .",
    "test": "npx vitest run",
    "build": "npm run build",
    "e2e": "npx playwright test"
  },
  "configFiles": [
    "svelte.config.js",
    "tsconfig.json"
  ],
  "arch": "web",
  "note": ""
}
