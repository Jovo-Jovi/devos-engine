{
  "id": "vite-react",
  "label": "Vite + React",
  "languages": [
    "typescript",
    "javascript"
  ],
  "fits": [
    "marketing",
    "extension",
    "web-app"
  ],
  "packageManager": "npm",
  "commands": {
    "install": "npm install",
    "typecheck": "npx tsc --noEmit",
    "lint": "npx eslint .",
    "test": "npx vitest run",
    "build": "npm run build",
    "e2e": "npx playwright test"
  },
  "configFiles": [
    "vite.config.ts",
    "tsconfig.json"
  ],
  "arch": "web",
  "note": "For extensions the bootstrap adds the extension manifest."
}
