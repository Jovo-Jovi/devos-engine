  "documents": [
    {
      "id": "brief",
      "label": "Product brief or PRD",
      "why": "the problem, the users and the must-have features, in your words"
    },
    {
      "id": "design",
      "label": "Design references",
      "why": "screens, sites or apps you like, and what you like about each"
    },
    {
      "id": "brand",
      "label": "Brand assets",
      "why": "logo, colours and fonts, if you have them"
    },
    {
      "id": "content",
      "label": "Content",
      "why": "page copy, product data or sample records"
    },
    {
      "id": "data",
      "label": "Data and API notes",
      "why": "existing schemas, APIs the product must call, sample payloads"
    },
    {
      "id": "rules",
      "label": "Business rules",
      "why": "roles and permissions, pricing, and any legal requirement you know of"
    }
  ]
