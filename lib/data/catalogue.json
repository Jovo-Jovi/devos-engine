  "modules": [
    {
      "id": "database",
      "label": "Database",
      "consequence": "Adds the database module. Every migration waits for your merge.",
      "providers": [
        {
          "id": "none",
          "label": "None"
        },
        {
          "id": "supabase",
          "label": "Postgres on Supabase",
          "method": "supabase"
        },
        {
          "id": "firebase",
          "label": "Firestore on Firebase",
          "method": "firebase"
        }
      ]
    },
    {
      "id": "storage",
      "label": "Storage",
      "consequence": "Adds file and object storage.",
      "providers": [
        {
          "id": "none",
          "label": "None"
        },
        {
          "id": "supabase-storage",
          "label": "Supabase Storage",
          "method": "supabase"
        },
        {
          "id": "r2",
          "label": "Cloudflare R2",
          "method": "r2"
        },
        {
          "id": "firebase-storage",
          "label": "Firebase Storage",
          "method": "firebase"
        },
        {
          "id": "s3",
          "label": "S3",
          "env": [
            "S3_BUCKET",
            "S3_ACCESS_KEY_ID",
            "S3_SECRET_ACCESS_KEY"
          ]
        },
        {
          "id": "vercel-blob",
          "label": "Vercel Blob",
          "env": [
            "BLOB_READ_WRITE_TOKEN"
          ]
        }
      ]
    },
    {
      "id": "auth",
      "label": "Auth",
      "consequence": "Adds sign-in. Accounts can hold personal data, so the boundary guard watches it.",
      "providers": [
        {
          "id": "none",
          "label": "None"
        },
        {
          "id": "email",
          "label": "Email and password"
        },
        {
          "id": "oauth",
          "label": "OAuth"
        },
        {
          "id": "email+oauth",
          "label": "Email and OAuth"
        }
      ]
    },
    {
      "id": "payments",
      "label": "Payments",
      "consequence": "Adds payments. Money flows need your review before launch.",
      "providers": [
        {
          "id": "none",
          "label": "None"
        },
        {
          "id": "stripe",
          "label": "Stripe",
          "env": [
            "STRIPE_SECRET_KEY",
            "STRIPE_WEBHOOK_SECRET"
