{
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "summary"],
  "properties": {
    "decision": { "type": "string", "enum": ["accept", "needs-info", "reject", "out-of-scope-revision", "revised"] },
    "od": { "type": ["string", "null"], "description": "the OD id drafted, e.g. OD-09" },
    "tasks": { "type": "array", "items": { "type": "string", "pattern": "^T[0-9]{2}$" } },
    "fence_written": { "type": ["string", "null"] },
    "questions": { "type": "array", "items": { "type": "string" }, "maxItems": 3 },
    "summary": { "type": "string", "description": "two to five sentences for the issue or PR comment" }
  }
}
