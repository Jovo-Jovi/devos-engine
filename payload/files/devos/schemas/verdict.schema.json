{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "task", "attempt", "review_file", "classification", "fence_defect", "fence_written", "summary"],
  "properties": {
    "verdict": { "type": "string", "enum": ["PASS", "FAIL"] },
    "task": { "type": "string", "pattern": "^T[0-9]{2}$" },
    "attempt": { "type": "integer", "minimum": 1 },
    "review_file": { "type": "string", "description": "docs/reviews/Tnn-aN.md" },
    "classification": {
      "type": "array",
      "items": { "type": "string", "enum": ["HARD FAILURE", "DOC CORRECTION", "CARRY-FORWARD", "FENCE DEFECT", "SETUP", "NONE"] }
    },
    "fence_defect": { "type": "boolean", "description": "true when a FAIL or HALT was caused by the fence itself (PR-09)" },
    "fence_written": {
      "type": ["string", "null"],
      "description": "path of the next fence (PASS) or the reissued fence (FAIL), or null when none was written"
    },
    "carry_forwards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "owner"],
        "properties": { "item": { "type": "string" }, "owner": { "type": "string" } }
      }
    },
    "human_attention": { "type": ["string", "null"], "description": "what the human must look at or decide, if anything" },
    "summary": { "type": "string", "description": "two or three sentences for the PR comment" }
  }
}
